<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.robomiri</groupId>
    <artifactId>jllm-serve</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!--
      No dependencies on purpose: JSON, HTTP client/server, tokenizer and compute kernels use only the JDK.
      The plugins below are build tooling, not runtime dependencies.

      Run:   ./jllm <command>            (compiles, builds the Metal library, launches with the right JVM flags)
      Test:  mvn test                    (runs SmokeTest against models/Qwen_Qwen3-0.6B; download it first)
      Note:  `java -jar target/jllm-serve.jar` does not work because a manifest cannot enable the
             incubating Vector API; use ./jllm, which passes the add-modules flag explicitly.
    -->

    <properties>
        <maven.compiler.release>26</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jllm.test.model>${project.basedir}/models/Qwen_Qwen3-0.6B</jllm.test.model>
    </properties>

    <build>
        <finalName>jllm-serve</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>26</release>
                    <compilerArgs>
                        <arg>--add-modules</arg>
                        <arg>jdk.incubator.vector</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- SmokeTest is a plain main() class (no test framework), run during the test phase. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>smoke-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>--add-modules</argument>
                                <argument>jdk.incubator.vector</argument>
                                <argument>--enable-native-access=ALL-UNNAMED</argument>
                                <argument>-cp</argument>
                                <classpath/>
                                <argument>org.robomiri.jllm.SmokeTest</argument>
                                <argument>${jllm.test.model}</argument>
                            </arguments>
                            <classpathScope>test</classpathScope>
                        </configuration>
                    </execution>
                    <!-- ServerTest: socket-level checks of the HTTP server against a fake backend. -->
                    <execution>
                        <id>server-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>--add-modules</argument>
                                <argument>jdk.incubator.vector</argument>
                                <argument>--enable-native-access=ALL-UNNAMED</argument>
                                <argument>-cp</argument>
                                <classpath/>
                                <argument>org.robomiri.jllm.ServerTest</argument>
                                <argument>${jllm.test.model}</argument>
                            </arguments>
                            <classpathScope>test</classpathScope>
                        </configuration>
                    </execution>
                    <!-- BatchDecodeTest: three slots decoding together give the answers they give alone. -->
                    <execution>
                        <id>batch-decode-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>--add-modules</argument>
                                <argument>jdk.incubator.vector</argument>
                                <argument>--enable-native-access=ALL-UNNAMED</argument>
                                <argument>-cp</argument>
                                <classpath/>
                                <argument>org.robomiri.jllm.BatchDecodeTest</argument>
                                <argument>${jllm.test.model}</argument>
                            </arguments>
                            <classpathScope>test</classpathScope>
                        </configuration>
                    </execution>
                    <!-- AgentDefaultsTest: backend.ctx=auto arithmetic, request priority parsing and the device queue order. -->
