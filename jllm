#!/bin/sh
# Launcher: ./jllm <command> [options]   (see ./jllm --help)
#
# Needs JDK 26+. Environment:
#   JAVA_HOME   JDK to use (default: the java on PATH)
#   JLLM_XMX    Java heap size, default 4g (the CPU backend keeps its KV cache on the heap)
#   JAVA_OPTS   extra JVM options, e.g. "-XX:+UseZGC -Djllm.metal.lib=/path/libjllm_metal.dylib"
#
# Relative paths given on the command line (--dir, --config, ./jllm.properties) resolve against the
# directory you run the command from, not against the repository.
set -eu
DIR="$(cd "$(dirname "$0")" && pwd)"
JAVA="${JAVA_HOME:+$JAVA_HOME/bin/}java"

# Incremental compile: Maven only recompiles changed sources, so this is cheap when up to date.
if [ -z "${JLLM_NO_BUILD:-}" ]; then
  (cd "$DIR" && mvn -q compile) || { echo "compilation failed" >&2; exit 1; }
  if [ "$(uname)" = "Darwin" ] && [ ! -f "$DIR/target/native/libjllm_metal.dylib" ]; then
    "$DIR/scripts/build-native.sh" >&2 || echo "warning: Metal library not built, using the CPU backend" >&2
  fi
fi

# The Metal library is looked up relative to the working directory by default; point at the repo's copy.
METAL_LIB="$DIR/target/native/libjllm_metal.dylib"
if [ -f "$METAL_LIB" ]; then
  JAVA_OPTS="${JAVA_OPTS:-} -Djllm.metal.lib=$METAL_LIB"
fi

# shellcheck disable=SC2086
exec "$JAVA" \
  --add-modules jdk.incubator.vector \
  --enable-native-access=ALL-UNNAMED \
  -XX:+UseParallelGC -Xmx"${JLLM_XMX:-4g}" \
  ${JAVA_OPTS:-} \
  -cp "$DIR/target/classes" \
  org.robomiri.jllm.Main "$@"
